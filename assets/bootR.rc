  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "boot.R"
      VALUE "FileDescription", "boot.R - UEFI boot manager"
      VALUE "InternalName", "bootR"
      VALUE "OriginalFilename", "bootR.efi"
      VALUE "ProductVersion", "1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
