[Desktop Entry]
Type=Application
Name=boot.R
GenericName=UEFI Boot Manager
Comment=Install the boot.R graphical boot manager to this computer's EFI partition
Exec=bash -c "boot-r-install; echo; read -r -p 'Press Enter to close. ' _"
Icon=boot-r
Terminal=true
Categories=System;Settings;
Keywords=boot;bootloader;uefi;efi;dual boot;
